OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- Docker Compose networking (read this) ---
# API_HOST_PORT / STREAMLIT_HOST_PORT only change ports ON YOUR MACHINE (host). They do not
# change URLs between containers. Streamlit must use API_URL=http://api:8000 (set in
# docker-compose.yml). Do NOT put API_URL=http://localhost:... in .env when using compose,
# or the Streamlit container will talk to itself.
#
# API_URL=http://api:8000
CO_API_KEY=

# Optional override (default is humansftw). Required header: X-Admin-Password
# MEETUP_ADMIN_PASSWORD=

# Persist meetup registry to JSON (default /tmp/meetup_agent_state.json locally).
# Loaded via pydantic Settings (same as the API) — not only raw os.environ.
# Set to empty string to disable persistence (admin/registry empty after API reload).
# Docker Compose sets MEETUP_STATE_FILE=/app/data/meetup_agent_state.json automatically.
# MEETUP_STATE_FILE=

LANGSMITH_API_KEY=
LANGSMITH_TRACING=
LANGSMITH_ENDPOINT=
LANGSMITH_PROJECT=

HYPERSYNC_API_KEY=

# Bluesky API credentials
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=